---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['Biznes', 'Zdrowie', 'Społeczeństwo', 'Polityka', 'Codzienność'];
const fmt = (d: Date) => d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="hero">
    <h1 class="cut" aria-label="LatteMachete">
      <span class="sp">Latte<br>Machete</span>
      <span class="a" aria-hidden="true">Latte<br>Machete</span>
      <span class="b" aria-hidden="true">Latte<br>Machete</span>
    </h1>
    <p class="lead">Przemyślenia o życiu, pieniądzach, zdrowiu i świecie wokół. Bez owijania w bawełnę.</p>
    <p class="sub">Kawa na stół, maczeta na slogany. Piszę o tym, co dotyka człowieka na co dzień.</p>
  </section>

  <section id="blog" aria-labelledby="blog-h">
    <h2 class="sec" id="blog-h">Wpisy</h2>

    <div class="posts" id="posts">
      {posts.map((p) => (
        <article class="post" data-cat={p.data.category}>
          <p class="meta"><b>{p.data.category}</b> &nbsp;{fmt(p.data.date)} &nbsp;{p.data.minutes} min</p>
          <h3><a href={`/wpis/${p.id}/`}>{p.data.title}</a></h3>
          <p>{p.data.excerpt}</p>
        </article>
      ))}
    </div>

    <p class="note">To przykładowe wpisy, żebyś zobaczył układ. Prawdziwe teksty podmienimy po zatwierdzeniu wyglądu.</p>

    <ul class="bar" id="filters">
      <li><button type="button" data-cat="all" aria-pressed="true">Wszystko</button></li>
      {categories.map((c) => (
        <li><button type="button" data-cat={c} aria-pressed="false">{c}</button></li>
      ))}
    </ul>
  </section>

  <section class="about" id="o-mnie">
    <h2>O mnie</h2>
    <p>Jestem Dawid. Pracuję, buduję własny biznes i wychowuję dziecko, więc o większości rzeczy piszę z doświadczenia, a nie z podręcznika.</p>
    <p>Na tym blogu znajdziesz:</p>
    <ul class="topics">
      <li>biznes i zarabianie, od pomysłu po pierwszych klientów</li>
      <li>zdrowie i formę, bez ściemy i bez cudów</li>
      <li>sprawy społeczne i polityczne, z różnych stron</li>
      <li>codzienne decyzje, które składają się na całe życie</li>
    </ul>
  </section>
</Base>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('#filters button');
    var posts = document.querySelectorAll('#posts .post');
    function markNewest() {
      var first = null;
      posts.forEach(function (p) {
        p.classList.remove('newest');
        var old = p.querySelector('.badge'); if (old) old.remove();
        if (!first && !p.hidden) first = p;
      });
      if (first) {
        first.classList.add('newest');
        var b = document.createElement('span'); b.className = 'badge'; b.textContent = 'Najnowszy';
        var meta = first.querySelector('.meta'); meta.insertBefore(b, meta.firstChild);
      }
    }
    markNewest();
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-cat');
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        posts.forEach(function (p) { p.hidden = !(cat === 'all' || p.getAttribute('data-cat') === cat); });
        markNewest();
      });
    });
  })();
</script>
